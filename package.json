{
  "name": "dnd-dm-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @dnd/server --filter @dnd/web run dev",
    "guard:docs-only": "node scripts/guards/check-docs-only.mjs",
    "guard:sensitive-files": "node scripts/guards/check-sensitive-files.mjs",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @dnd/rules test && pnpm --filter @dnd/server test && pnpm --filter @dnd/web test && node --test scripts/smoke.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "prettier": "3.8.3",
    "typescript": "5.5.4"
  }
}
