# Copy to .env at the repo root. apps/server/src/index.ts loads it from there.
# Never commit a real .env.

# Persistence. Default startup is in-memory; auth and the Character Library
# require db mode plus applied migrations.
SERVER_PERSISTENCE_MODE=in-memory
DATABASE_URL=postgres://username:password@localhost:5432/dnd_web

SERVER_HOST=127.0.0.1
SERVER_PORT=2567

# Browser origins allowed by CORS. Comma-separated origins are supported, e.g.
# http://localhost:3000,http://localhost:3001
# This must match the origin the browser actually sends. A mismatch blocks every
# request from the deployed app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where the browser sends commands. Baked into the web bundle at build time, so
# changing it needs a rebuild rather than a restart.
NEXT_PUBLIC_SERVER_URL=http://localhost:2567

# Session cookie flags. Must be false on plain HTTP: a Secure cookie over HTTP is
# silently dropped by the browser, which makes login look like it worked and then
# not work. Defaults to true when NODE_ENV=production, so set it explicitly for
# an HTTP deployment.
AUTH_COOKIE_SECURE=false

# Only enable behind a proxy you control. x-forwarded-for is client-supplied, and
# trusting it lets a single host mint unlimited auth rate-limit keys.
SERVER_TRUST_PROXY_HEADER=false

# Request body guards. Bodies over the ceiling get HTTP 413; bodies that stall
# past the timeout get HTTP 408.
SERVER_MAX_REQUEST_BODY_BYTES=1048576
SERVER_REQUEST_BODY_TIMEOUT_MS=15000
