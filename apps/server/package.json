{
  "name": "@dnd/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node --import tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dnd/db": "workspace:*",
    "@dnd/protocol": "workspace:*",
    "@dnd/rules": "workspace:*",
    "@dnd/shared": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2"
  }
}
